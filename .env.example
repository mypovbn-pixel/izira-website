NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# KADAI Assistant
NEXT_PUBLIC_KADAI_BOT_NAME=KADAI Assistant
# Create a separate KADAI website/site in BubblaV before setting this.
# Do not reuse the myPOV / POVI site ID.
NEXT_PUBLIC_KADAI_BUBBLAV_SITE_ID=

# Supabase Edge Function secrets for Meta WhatsApp Business Platform.
# Configure these in Supabase secrets, not in client-side Lovable variables.
META_GRAPH_VERSION=v23.0
META_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
